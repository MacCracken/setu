# client.cyr — setu's reference CLIENT + SERVER transport (persistent connection),
# shared by every consumer (dhancha, puka, crab) so there is ONE client, not three.
# setu = the protocol CONTRACT (proto/codec) + this transport.
#
# ============================================================================
# ⭐ TRANSPORT: RECORDS ON BOTH TARGETS. TCP IS GONE.
# ============================================================================
#   agnos — the `#97` channel band. The client does NOT dial: the compositor mints a channel,
#           endows one end, and spawns the client already holding it. `setu_connect` reads which fd
#           it landed on out of `AGNOS_CHAN` and returns it. Four lines, no socket, no port.
#   Linux — AF_UNIX / SOCK_SEQPACKET. A local, connected, RECORD transport: same delivery semantics
#           as the band, a filesystem path as the rendezvous, and its permissions as the access
#           control loopback:7700 never had.
#
# ⭐ THE TWO ARMS AGREE ON SEMANTICS, WHICH IS THE POINT. One send is one record; one record is one
# message; a frame that does not fit a record is an ERROR rather than something to split. Because both
# arms obey that, `setu_read_msg` has no `#ifdef` at all, and a consumer cannot be correct on one
# target and broken on the other for a framing reason.
#
# ⛔ WHY TCP WAS REMOVED — AND WHY REMOVING IT ONLY FROM agnos WAS NOT ENOUGH. TCP-on-loopback was
# adopted at 0.3.0 because a TCP stack happened to exist; it was never put to the operator, and was
# carried behind six accommodations. A local display protocol has nothing to route, nothing to
# checksum, no window to negotiate, no RTO to wait out, and no business owning a port. That is a
# property of the PROBLEM, not of the kernel — so scoping the removal to agnos left the rejected
# primitive alive on the target that was easiest to keep testing against, and it survived four cuts
# there while every changelog asserted it was gone. setu 0.1.0 was AF_UNIX; this restores it.
#
# ⛔ HISTORICAL, KEPT BECAUSE THE LESSON OUTLIVES THE TRANSPORT: the only test that ever showed the
# agnos TCP path passing before 1.56.34 / `net_src_for` passed BY ACCIDENT. The kernel hook
# `AETHERSAFHA_SETU_SELFTEST` assigned `net_ip = 0x7F000001` before launching the compositor; agnos
# stamped `net_ip` as the source of every outbound segment, so a SYN to 127.0.0.1 was answered to
# `net_ip` and `tcp_find_conn` never matched — except under that hook, where src == dst made it match.
# A harness that rigs the system under test is not evidence about the system.
# ============================================================================
#
# Per-target semantics the framing absorbs (each arm #ifdef-guarded):
#   - agnos: `chan_recv` answers AT ONCE and says which — a record's length, -CH_E_WOULDBLOCK
#     (nothing yet) or -CH_E_PEERGONE (peer gone). `chan_send` delivers one record of <= 64 B or
#     nothing.
#   - Linux: reads block on the connected fd (0 = EOF); the frame-loop polls ask per call with
#     MSG_DONTWAIT instead (EAGAIN = nothing yet). A SOCK_SEQPACKET write is one record.
#   So no write loops on either target, and a frame over 64 B is refused on both.
#
# Model: connect once → create surface once → per present, pixels into the shared buffer
# (buf.cyr), then ATTACH (by buf_id) + COMMIT on the wire.

# ⛔⛔ TCP IS GONE FROM setu ON BOTH TARGETS. The operator's ruling was that TCP-on-loopback is the
# WRONG PRIMITIVE for LOCAL DISPLAY IPC — a property of the problem, not of the kernel. Scoping the
# removal to agnos and leaving Linux on TCP kept the rejected primitive alive in the one place it was
# easiest to keep testing against, which is how it survived four cuts.
#
# ⭐ LINUX NOW SPEAKS AF_UNIX / SOCK_SEQPACKET, which is the SAME SEMANTIC as the agnos channel band:
# a connected, local, RECORD transport with all-or-nothing message delivery and no namespace anyone
# else can squat. That is not a coincidence — the band's own host semantic proof
# (`agnos/tests/chan/chantest.cyr`) is written against `socketpair(SOCK_SEQPACKET)`, and its negative
# control over `SOCK_STREAM` fails exactly the six framing assertions. Both arms now agree, so the
# stream-vs-record class of bug that caused three consecutive setu cuts cannot recur on one arm only.
#
# ⚠ setu 0.1.0 WAS AF_UNIX. TCP was adopted because agnos had a TCP stack and no AF_UNIX — reuse, not
# design. This restores the original primitive on the host and pairs it with the sovereign one.
#ifndef CYRIUS_TARGET_AGNOS
# ⭐ THE ONE PLACE THE RENDEZVOUS IS NAMED (0.8.5). Before this, FOUR repos each spelled
# "/tmp/aethersafha-setu.sock" as their own literal — aethersafha, crab, puka and setu's own
# present_probe — while this constant sat here unreachable because nothing ever passed 0. They
# happened to agree, so nothing was broken; the hazard was that four files had to be edited in step
# for that to stay true, and a fifth answer existed that no caller could reach.
# ⚠ The name is deliberately PROTOCOL-shaped, not compositor-shaped: setu owns the wire, so a second
# compositor speaking setu binds the same place. `$SETU_SOCKET` is how two coexist on one box.
var SETU_UNIX_PATH = "/tmp/setu-display.sock";

# ⭐ NO PRIVATE SYSCALL TABLE. `sys_socket` / `sys_connect` / `sys_bind` / `sys_listen` /
# `sys_accept4` / `sys_recvfrom` / `sys_unlinkat` already exist in the cyrius stdlib
# (`lib/syscalls_linux_common.cyr`), are per-arch correct, and need no renumber chain.
#
# ⛔ THE FIRST CUT OF THIS ARM HARDCODED RAW x86 NUMBERS, AND THE REASONING WAS WRONG TWICE.
# (1) It concluded "cyrius has no wrappers" after reading `net.cyr` — which indeed has no AF_UNIX —
#     without checking the syscall PEERS, where every wrapper it needed already lived.
# (2) It then claimed the aarch64 backend's `ESYSXLAT` had no socket rows, having read the **macho**
#     block (`emit.cyr:760-773`); the Linux x86-compat socket block is at `:865-873` and does contain
#     41→198, 42→203, 43→202, 49→200, 50→201.
# ⚠ Both errors pointed the same way — toward hand-rolling — and the result would have been
# PARTIALLY correct on aarch64, which is the worst outcome: the five socket numbers are renumbered,
# but `recvfrom` (45) is not in that block at all, and `unlink` (87) cannot be renumbered on principle
# because aarch64 Linux has no `unlink(2)` — only `unlinkat(AT_FDCWD, path, 0)`, a different ARITY.
# A renumber chain rewrites x8; it cannot add an argument.
# Filed against cyrius: `2026-07-30-net-cyr-x86-only-socket-syscall-numbers.md` §5a and §9.
var SETU_AT_FDCWD = 0 - 100;

var SETU_AF_UNIX        = 1;
var SETU_SOCK_SEQPACKET = 5;
var SETU_SOCK_NONBLOCK  = 2048;    # 0o4000 — set on the LISTEN fd only; accepted fds do not inherit it
var SETU_MSG_DONTWAIT   = 64;      # 0x40 — per-call non-blocking recv, for the frame-loop polls

# Build a `sockaddr_un` at `sa` (needs >= 112 bytes) and return its addrlen.
# Layout: u16 sun_family, then the NUL-terminated path. addrlen = 2 + len + 1.
fn setu_un_addr(path, sa): i64 {
    var n = strlen(path);
    if (n > 100) { return 0 - 1; }                 # sun_path is 108; stay well inside it
    store8(sa, SETU_AF_UNIX);                      # little-endian u16 family
    store8(sa + 1, 0);
    var i = 0;
    while (i < n) { store8(sa + 2 + i, load8(path + i)); i = i + 1; }
    store8(sa + 2 + n, 0);
    return 2 + n + 1;
}

# The path to rendezvous on. Precedence: the caller's explicit `path` > `$SETU_SOCKET` > the compiled
# default. ⭐ 0.8.5 moved the env override HERE from the callers, so `0` means "ask setu" and every
# client and server agrees by construction rather than by four files being edited together.
# ⚠ puka used to implement `$SETU_SOCKET` itself and crab/present_probe did not, so the override
# worked for exactly one of three clients. One place, one answer.
fn setu_un_path(path): i64 {
    if (path != 0) { if (strlen(path) != 0) { return path; } }
    var e = getenv("SETU_SOCKET");
    if (e != 0) { if (strlen(e) != 0) { return e; } }
    return SETU_UNIX_PATH;
}
#endif

# =========================================================================
# Transport + framing primitives (over the setu codec). See the banner at the
# top of this file: agnos = the `#97` channel band, Linux = AF_UNIX/SOCK_SEQPACKET.
# =========================================================================

# Connect to the compositor. Linux: AF_UNIX/SOCK_SEQPACKET at `path` (or the default rendezvous).
# agnos: NO DIAL — returns the endowed fd named by `AGNOS_CHAN`. Returns the fd (>= 0), or -2
# (socket) / -3 (connect) on Linux, -8 (no usable chan band) / -9 (no announcement) on agnos.
# `setu_connect_error` / `setu_connect_rc` separate failures that otherwise collapse to one message.
var setu_conn_err = 0;      # -2 / -3 (Linux), -8 / -9 (agnos). 0 = last one worked.
var setu_conn_rc = 0;       # raw kernel return behind a Linux -2 (sys_socket) / -3 (sys_connect); 0 if none.
fn setu_connect_error(): i64 { return setu_conn_err; }
fn setu_connect_rc(): i64 { return setu_conn_rc; }

#ifdef CYRIUS_TARGET_AGNOS
# ⛔ REFUSE ON A PRE-`#97` KERNEL RATHER THAN LIMP. §9.9: "If a client silently *appears* to work on a
# pre-#97 kernel instead of refusing at startup, CH_CAPS is not doing its job." An unknown syscall
# number on agnos falls through the dispatch chain and the caller reads the fall-through value as data,
# so "it returned something" is NOT evidence the band exists — the caps block is.
fn setu_chan_floor_ok(): i64 {
    var caps = alloc(CH_CAPS_BUFSZ);
    store64(caps, 0);
    store64(caps + 8, 0);
    if (sys_chan_caps(caps, CH_CAPS_BUFSZ) != 0) { return 0; }
    # SEND and RECV must both be advertised; a kernel that has the number but not the ops is worse
    # than one that has neither, because it answers.
    var mask = load32(caps);
    if ((mask & 0x04) == 0) { return 0; }            # CH_SEND
    if ((mask & 0x08) == 0) { return 0; }            # CH_RECV
    if (load64(caps + 8) != 1) { return 0; }         # the region must be reachable from OUR CR3
    return 1;
}

# The fd the compositor endowed us, announced in our environment at spawn. This is Wayland's
# `WAYLAND_SOCKET` shape: the parent decides the number and tells the child; the child never searches.
# ⛔ Do NOT "fall back to scanning for a working fd" if this is absent. Scanning would find a channel
# this process was not given — and on a kernel where that succeeds, inert-by-construction is broken and
# the right behaviour is to FAIL LOUDLY, not to paper over it.
fn setu_chan_announced_fd(): i64 {
    var v = getenv("AGNOS_CHAN");
    if (v == 0) { return 0 - 1; }
    var n = 0;
    var i = 0;
    var any = 0;
    while (load8(v + i) >= 48) {
        if (load8(v + i) > 57) { return 0 - 1; }
        n = n * 10 + (load8(v + i) - 48);
        any = 1;
        i = i + 1;
    }
    if (any == 0) { return 0 - 1; }
    if (n < 3) { return 0 - 1; }                     # 0/1/2 are stdio; a channel is never there
    if (n >= 32) { return 0 - 1; }
    return n;
}
#endif

fn setu_connect(path): i64 {
    setu_conn_err = 0;
    setu_conn_rc = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    # ⭐⭐ THE CUTOVER. On agnos this function NO LONGER DIALS ANYTHING — there is no socket, no
    # connect, no port, no loopback address. The client is HANDED a channel at spawn and reads which
    # fd it landed on out of its environment. The TCP arm is DELETED, not gated: agnos `planning/ipc.md`
    # §9.6 is explicit that a plan preserving the old path "has not done the job", and revertibility
    # comes from bite ORDER, not from keeping a rejected transport compiled in.
    #
    # ⛔ WHAT WENT WITH IT, and why none of it is a loss: the `sock_connect #47` that held preempt
    # disabled for the whole attempt and starved the compositor being dialled · the retry loop that
    # could not be added because of it · the ~2 KB loopback window · the DHCP dependency a LOCAL
    # display protocol had acquired · and the `net_ip` source-address semantics that made
    # `net_src_for` necessary. Six accommodations around one choice, which is what falsified it
    # (§10.0). ⚠ `net_src_for` itself STAYS — route-derived source selection is correct for the
    # NETWORK (§10.4). What is retired is a display protocol riding on it.
    #
    # ⛔ THE FLOOR IS ENFORCED, NOT DOCUMENTED. A client built against this must REFUSE on a kernel
    # without `#97` rather than appear to work — §9.9's last kill criterion names exactly that, and
    # `CH_CAPS` is what makes it checkable. `path` is now advisory (there is no namespace to look up).
    # ⛔ DISTINCT ASCII STRINGS, NOT RETURN CODES. Three procs share one console unserialised on agnos,
    # so a numeric code printed by the caller lands mid-line inside another proc's output and is
    # unreadable. That cost several diagnostic cycles: the failure was inferred from silence instead of
    # read. Each branch says what it is, in bytes that survive interleaving.
    if (setu_chan_floor_ok() == 0) {
        sys_write(1, "setu: refusing, kernel has no usable chan band\n", 46);
        setu_conn_err = 0 - 8; return 0 - 8;
    }
    var afd = setu_chan_announced_fd();
    if (afd < 0) {
        sys_write(1, "setu: refusing, AGNOS_CHAN absent or malformed\n", 46);
        setu_conn_err = 0 - 9; return 0 - 9;
    }
    return afd;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # ⭐ AF_UNIX / SOCK_SEQPACKET — a LOCAL, CONNECTED, RECORD transport. No route, no checksum, no
    # window, no RTO, no port. The filesystem path is the rendezvous, and its permissions are the
    # access control TCP-on-loopback never had (anything on the host could dial 7700).
    var sa = alloc(128);
    var alen = setu_un_addr(setu_un_path(path), sa);
    if (alen < 0) { setu_conn_err = 0 - 2; return 0 - 2; }
    var fd = sys_socket(SETU_AF_UNIX, SETU_SOCK_SEQPACKET, 0);
    if (fd < 0) { setu_conn_err = 0 - 2; setu_conn_rc = fd; return 0 - 2; }
    var rc = sys_connect(fd, sa, alen);
    if (rc < 0) {
        sys_close(fd);
        setu_conn_err = 0 - 3;
        setu_conn_rc = rc;
        return 0 - 3;
    }
    return fd;
    #endif
}

# --- server transport (the compositor owns the listener) ---------------------

# Bind + listen on the setu endpoint. Linux: AF_UNIX/SOCK_SEQPACKET at `path` (or the default
# rendezvous). agnos: REFUSES with -2 — there is no listener on the channel band; clients are
# placed, never accepted. Returns the listening fd (>= 0), or -2 (socket) / -3 (bad path or bind) /
# -4 (listen). The fd is set non-blocking so setu_accept polls instead of stalling the frame loop.
# ⛔ The agnos arm was once a network LISTENER on loopback:7700, costing a well-known port plus TWO
# of the eight system-wide TCP conn slots per connection, so listener + 3 clients exhausted the
# table the NETWORK is supposed to use (agnos `planning/ipc.md` §10.1). See the agnos arm below.
fn setu_listen(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ THERE IS NO LISTENER ON AGNOS. A compositor does not accept connections on the channel band —
    # it MINTS a channel per client, ENDOWS one end, and spawns the client already holding it. Nothing
    # dials, so there is nothing to bind, nothing to listen on, and no port to own.
    # ⛔ THIS FUNCTION USED TO OPEN loopback:7700 ON AGNOS. setu 0.8.0 claimed the agnos TCP arm was
    # deleted; it was deleted from `setu_connect` only, and this one was missed through four cuts. It
    # is the reason `net` was still a live agnos dependency and the reason ipc bite 8 ("nothing dials
    # 7700/7701") was false while being treated as reachable.
    # ⛔ REFUSE, DO NOT EMULATE. A caller reaching here on agnos is using the retired transport shape,
    # and the correct answer is a loud failure, not a channel dressed up as a socket.
    return 0 - 2;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # ⛔ UNLINK FIRST. An AF_UNIX path is a filesystem entry that OUTLIVES the process: a compositor
    # killed without a clean shutdown leaves the node behind and every later bind fails EADDRINUSE.
    # That is the same "run 2 hosts nothing and looks healthy" failure the TCP listener had when it
    # leaked port 7700 — same shape, and the fix belongs here, at bind time, not in a shutdown path
    # that a crash skips.
    var up = setu_un_path(path);
    var sa = alloc(128);
    var alen = setu_un_addr(up, sa);
    if (alen < 0) { return 0 - 3; }
    sys_unlinkat(SETU_AT_FDCWD, up, 0);              # ENOENT is fine and expected on a clean start
    # SOCK_NONBLOCK on the LISTEN fd so `setu_accept` polls and the frame loop never stalls.
    # ⚠ Accepted fds do NOT inherit it on Linux — which is what we want: the per-client fd stays
    # blocking for `setu_read_blk`, and the frame-loop polls use MSG_DONTWAIT per call instead.
    var fd = sys_socket(SETU_AF_UNIX, SETU_SOCK_SEQPACKET | SETU_SOCK_NONBLOCK, 0);
    if (fd < 0) { return 0 - 2; }
    if (sys_bind(fd, sa, alen) < 0) { sys_close(fd); return 0 - 3; }
    if (sys_listen(fd, 8) < 0) { sys_close(fd); return 0 - 4; }
    return fd;
    #endif
}

# Accept the next pending client on `sfd`. Returns the client fd (>= 0), or -5
# when none is pending (WOULD_BLOCK — the compositor polls again next frame).
# Non-blocking on BOTH targets, so the frame loop never stalls on accept.
fn setu_accept(sfd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ NOTHING TO ACCEPT — see setu_listen. Clients are PLACED, never accepted.
    return 0 - 5;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var cfd = sys_accept4(sfd, 0, 0, 0);             # == accept(fd, NULL, NULL); bote 3.2.1's swap
    if (cfd >= 0) { return cfd; }
    return 0 - 5;                                    # EAGAIN / no client pending
    #endif
}

# --- write --------------------------------------------------------------------

# Write `n` bytes from `buf` to `fd` as ONE record — no loop, on either target. Returns `n`
# (>= 0), or -7 if `n` > 64 or the send fails or comes up short.
fn setu_write_all(fd, buf, n): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⭐ ONE RECORD, ALL-OR-NOTHING — there is no partial send to loop over. Framing is a property of
    # the CHANNEL, fixed at mint, so the "loop over partial sends" this function existed for is a
    # stream-transport concern that does not apply. Every production setu message is <= 64 B (the
    # protocol ceiling is 80), which is the record size the band carries.
    # ⛔ A frame too big for one record is an ERROR, not something to silently split: splitting would
    # reintroduce, in userland, exactly the message-boundary problem the band was chosen to remove.
    if (n > 64) { return 0 - 7; }
    if (sys_chan_send(fd, buf, n) != n) { return 0 - 7; }
    return n;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # ⭐ SAME RULE AS AGNOS. On SOCK_SEQPACKET a write IS a record — there is no partial send to loop
    # over, and the loop this function used to run was a stream artifact. Keeping the 64-byte ceiling
    # on both arms is deliberate: a frame that does not fit one record is an ERROR on both targets, so
    # a client cannot be correct on Linux and broken on agnos (or the reverse) for a framing reason.
    if (n > 64) { return 0 - 7; }
    if (sys_write(fd, buf, n) != n) { return 0 - 7; }
    return n;
    #endif
}

# Encode `msg` and write the whole frame to `fd`. Returns bytes written (> 0), a
# negated SetuErr on encode failure, or -7 on a write error. Widest frame ≤ 128 B.
fn setu_send(fd, msg): i64 {
    var cap = 128;
    var buf = alloc(cap);
    var enc = setu_encode(msg, buf, cap);
    if (enc < 0) { return enc; }
    if (setu_write_all(fd, buf, enc) < 0) { return 0 - 7; }
    return enc;
}

# Read ONE record into `buf` (cap `cap`), blocking until one arrives. Returns its length
# (> 0), or -6 on EOF / peer gone / error / timeout.
#   agnos — `chan_recv` answers at once; on WOULDBLOCK the loop busy-spins (preemptible) and
#           retries until a wall-clock deadline ~8 s out, then returns -6.
#   Linux — one blocking read on the connected fd; 0 (EOF) or an error returns -6.
fn setu_read_blk(fd, buf, cap): i64 {
    # ⛔ BOUND BY WALL CLOCK, NOT BY ITERATIONS. The retry budget has to be a DURATION, because what it
    # is waiting for is a peer being scheduled. The first cut replaced `sys_sleep_ms(2)` with a fixed
    # spin count — correct in shape (preemptible, does not starve the peer) and badly wrong in
    # magnitude: ~1e8 increments is ~0.1 s where the old sleep gave ~10 s, so a client gave up on
    # `surface_created` about a hundred times too early. The compositor was replying; nobody was left
    # listening. An iteration count silently means a different duration on every machine.
    # ⛔ THE DEADLINE IS READ INSIDE THE AGNOS ARM, NOT HOISTED. `sys_uptime_ms` exists ONLY in
    # `syscalls_x86_64_agnos.cyr` — there is no Linux definition. Declared here (both targets need the
    # slot) but only ASSIGNED under `#ifdef`, so the Linux build never references the symbol.
    # ⚠ 0.8.2 hoisted the call and shipped: setu's own smoke does not REACH `setu_read_blk`, so cycc
    # demoted it to `warning: undefined function` and the lib built green on both targets. The first
    # consumer that actually calls it (crab) got `error: refusing to emit binary with 1 reachable
    # undefined function(s)`. A target-only symbol is invisible until something makes it reachable.
    var deadline = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    deadline = sys_uptime_ms() + 8000;
    #endif
    var tries = 0;
    while (tries <= 5000) {
        #ifdef CYRIUS_TARGET_AGNOS
        # ⭐ WOULD_BLOCK IS NOW A DISTINCT, IMMEDIATE ANSWER — which is the whole point. The old
        # `sys_read` path routed a tagged socket fd through the stdlib's `_agnos_sock_recv_block`,
        # which polled under a **30 second** deadline and returned 0 for BOTH EOF and timeout, so
        # `r == 0` could never mean "would-block" and this loop multiplied a ~30 s call. `chan_recv`
        # answers immediately and says WHICH: -8 nothing yet, -9 peer gone. The old note that ring 3
        # has "no way to ask 'is a byte waiting?'" is obsolete on this path.
        var r = sys_chan_recv(fd, buf, cap);
        if (r > 0) { return r; }
        if (r == 0 - CH_E_PEERGONE) { return 0 - 6; }
        if (r != 0 - CH_E_WOULDBLOCK) { return 0 - 6; }  # a real error, not "nothing yet"
        tries = tries + 1;
        # ⛔ NOT `sys_sleep_ms`, AND NOT `sched_yield`. Both starve the peer this call is waiting FOR:
        # sleep_ms is the `preempt_disable; sti; hlt` spin that ipc.md §9.4 calls "the poison that made
        # TCP toxic", and sched_yield is a documented silent no-op under four guards. A client blocking
        # here for SURFACE_CREATED therefore prevented the COMPOSITOR from running to send it —
        # a deadlock that ended with the client timing out, exiting, and the compositor seeing
        # PEER_GONE on a channel whose peer had been alive the whole time.
        # ⭐ A plain spin holds NO preempt and issues NO syscall, so the 100 Hz timer preempts it and
        # the peer gets scheduled. That is the only wait shape on agnos that does not starve.
        var spin = 0;
        while (spin < 20000) { spin = spin + 1; }
        if (sys_uptime_ms() < deadline) { tries = 0; }   # keep going until the DEADLINE, not the count
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        var r = sys_read(fd, buf, cap);
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        if (r <= 0) { return 0 - 6; }               # 0 = EOF on Linux
        return r;
        #endif
    }
    return 0 - 6;                                    # would-block timeout (agnos)
}

# Read ONE setu frame (one record) from `fd` into `msg_out`. Returns the decoded
# length (> 0), -6 on EOF / error / timeout, or a negated SetuErr. Now that both
# transports are record transports this is the same read as setu_read_msg.
fn setu_recv(fd, msg_out): i64 {
    var cap = 256;
    var buf = alloc(cap);
    var n = setu_read_blk(fd, buf, cap);
    if (n <= 0) { return 0 - 6; }
    return setu_decode(buf, n, msg_out);
}

# Poll for ONE inbound frame (the S->C input channel). Returns 1 and fills `msg_out`
# when a frame arrived, 0 when nothing is pending, or -6 on EOF/error.
# NON-BLOCKING on both targets: agnos `chan_recv` answers at once (-CH_E_WOULDBLOCK =
# nothing yet); Linux asks per call with MSG_DONTWAIT (EAGAIN = nothing yet).
# ⚠ Decodes only the FIRST frame of each record and drops any rest — harmless from a setu
# peer, which sends one frame per record. setu_client_poll_input keeps the rest and reassembles.
fn setu_poll_input(fd, msg_out): i64 {
    var cap = 256;
    var buf = alloc(cap);
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ MISSED BY THE 0.8.0 CUTOVER. This still called `sys_read`, whose comment claimed "agnos:
    # non-blocking (0 = would-block)" — true of the old TCP fd's stdlib wrapper, and MEANINGLESS for a
    # channel fd, which does not route through `sys_read` at all. Every client's per-frame input poll
    # was therefore reading nothing on agnos. The record/stream halves were cut over and the POLL half
    # was not, which is what makes a partial cutover worse than none: the working paths hide it.
    var r = sys_chan_recv(fd, buf, cap);
    if (r == 0 - CH_E_WOULDBLOCK) { return 0; }    # nothing this frame — the common case
    # ⛔ SAY WHICH. Collapsing every negative into -6 hid the actual cause for several cycles: the
    # caller could not tell "peer gone" from "bad fd" from "record did not fit", which are three
    # different bugs in three different places.
    if (r < 0) { return 0 - 6; }   # peer gone / bad fd / record did not fit — all terminal here
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # ⭐ MSG_DONTWAIT, not a non-blocking fd. The accepted/connected fd stays BLOCKING so
    # `setu_read_blk` can actually block; only the frame-loop poll asks for a non-blocking answer.
    # ⛔ `sys_read` here was a real bug in the old arm too: it BLOCKS on a blocking fd, so a poll that
    # promised "never stalls" stalled the whole frame loop whenever no input was pending.
    var r = sys_recvfrom(fd, buf, cap, SETU_MSG_DONTWAIT, 0, 0);
    if (r < 0)  { return 0; }              # EAGAIN — nothing this frame (the common case)
    if (r == 0) { return 0 - 6; }          # EOF — peer gone
    #endif
    if (setu_decode(buf, r, msg_out) < 0) { return 0; }   # partial/garbled → skip
    return 1;
}

# REFUSED: always returns -6 and reads nothing. The "read exactly `n` bytes" contract
# this name promises belongs to a stream transport, which setu no longer has.
fn setu_read_exact(fd, buf, n): i64 {
    # ⛔ REFUSED ON BOTH TARGETS AS OF THE AF_UNIX CUTOVER. "Read exactly N bytes" is a STREAM idiom
    # and both arms are now record transports; emulating it would re-import, in userland, the
    # message-boundary problem both were chosen to delete. It is kept as a symbol only so consumers
    # that still reference it fail loudly at the call rather than mysteriously at the wire.
    return 0 - 6;
}

# Read ONE full setu frame from `fd` into `msg_out`: one record, decoded. Returns the
# frame length (> 0), -6 on EOF / error / timeout, or a negated SetuErr when the record
# is not a valid frame.
fn setu_read_msg(fd, msg_out): i64 {
    # ⭐⭐ NO `#ifdef` HERE ANY MORE, AND THAT IS THE POINT OF THE AF_UNIX CUTOVER. agnos delivers a
    # record over the `#97` channel band; Linux delivers a record over AF_UNIX/SOCK_SEQPACKET. One
    # record is one message on both, so this function has ONE body and the two targets cannot drift.
    #
    # ⛔ THE STREAM SHAPE THIS REPLACES FAILED SILENTLY FOR TWO RELEASES. Reading 16 bytes of header
    # first asks for a PREFIX of a record: the agnos kernel truncated to the caller's buffer and
    # advanced past the remainder, so the header read consumed the ENTIRE message and the body read
    # found nothing — surfacing as an unexplained handshake failure inside aethersafha, two layers and
    # one repo from the cause. It would have done the same thing on SOCK_SEQPACKET.
    # (agnos 1.56.40 now returns -CH_E_ARG and leaves the record queued, so the mistake is loud
    # instead of silent — but the fix is to stop making it.)
    #
    # ⛔ AND IT MUST STILL BLOCK. An early cut returned on WOULD_BLOCK, dropping the retry the stream
    # version got for free. The handshake is three messages and the caller reaches here for ATTACH and
    # COMMIT *before the client has sent them*, so a non-retrying read fails whenever the peer is a few
    # microseconds behind. `setu_read_blk` owns the retry policy and reads one record per attempt, so
    # the record shape and the blocking shape compose rather than conflict.
    var buf = alloc(128);
    var r = setu_read_blk(fd, buf, 128);
    if (r <= 0) { return 0 - 6; }
    return setu_decode(buf, r, msg_out);
}

# =========================================================================
# SetuClient — the persistent app-facing handle ("each app owns its connection")
# =========================================================================

enum SetuClientOff {
    SETU_C_FD    = 0;    # connected setu fd
    SETU_C_SID   = 8;    # compositor-assigned surface id (0 until first present)
    SETU_C_FLAGS = 16;   # CREATE_SURFACE flags to request (e.g. SETU_SURF_FULL_KEYS)
    SETU_C_BUFID = 24;   # cached shared-buffer id (0 = none) — ONE per client, reused
    # across presents, replaced on resize (a second one exists only inside that present),
    # freed at close.
    # ⛔ Never create one per present: that exhausts agnos's 16
    # kernel shm slots in under a second at 35 Hz.
    SETU_C_BUFSZ = 32;   # size in bytes of the cached shared buffer
    SETU_C_INBUF = 40;   # input stream-reassembly buffer (lazily alloc'd, 0 until first poll)
    SETU_C_INLEN = 48;   # bytes currently buffered in SETU_C_INBUF
    SETU_C_SZ    = 56;
}

var SETU_C_INBUF_CAP = 512;   # ≥ 6 widest frames ((2+8)*8 = 80 B); input frames are 40 B

# Connect to the compositor's setu endpoint. Returns a *SetuClient, or 0 on
# failure. The surface is created lazily on the first setu_client_present.
# No retry loop, and on agnos nothing to retry: a placed channel is never dialled, so a
# client either holds the end it was endowed at spawn or never will, and -8 / -9 are final.
# On Linux a failed connect returns 0 at once; setu_connect_error / setu_connect_rc say why.
# ⛔ The old TCP arm could not usefully retry either: agnos `sock_connect` #47 held preempt for
# the whole attempt, so a retrying client starved the compositor it was waiting for (200
# retries stretched a 30 s budget to 72 s with ZERO connections) — one of the six
# accommodations that falsified TCP (agnos `planning/ipc.md` §10.0).
fn setu_client_connect(path): i64 {
    var fd = setu_connect(path);
    if (fd < 0) { return 0; }
    var c = alloc(SETU_C_SZ);
    store64(c + SETU_C_FD, fd);
    store64(c + SETU_C_SID, 0);
    store64(c + SETU_C_FLAGS, 0);
    store64(c + SETU_C_BUFID, 0);
    store64(c + SETU_C_BUFSZ, 0);
    store64(c + SETU_C_INBUF, 0);
    store64(c + SETU_C_INLEN, 0);
    return c;
}

fn setu_client_fd(c): i64  { return load64(c + SETU_C_FD); }
fn setu_client_sid(c): i64 { return load64(c + SETU_C_SID); }

# Request FULL keyboard events (press AND release) for this client's surface so an app
# can track HELD keys, instead of the default press-only stream. Call BEFORE the first
# setu_client_present — the flag rides the CREATE_SURFACE handshake (arg2). The compositor
# then delivers SETU_INPUT_KEY with arg2 = 1 (press) / 0 (release). Press-only clients
# (that never call this) keep flags 0, so the compositor sends presses only with arg2 = 0
# — byte-identical to the pre-0.5.0 behaviour. Returns 0.
fn setu_client_request_keys(c): i64 {
    store64(c + SETU_C_FLAGS, load64(c + SETU_C_FLAGS) | SETU_SURF_FULL_KEYS);
    return 0;
}

# @public — declare that this client's surface pixels are PREMULTIPLIED BGRA (c <= a), so the
# compositor blends per-pixel (gpu_shader_op#92 op 0x01) instead of copying opaquely
# (gpu_blit_shm#87). Call BEFORE setu_client_connect — the flag rides CREATE_SURFACE.
# ⚠ Only set this if the pixels really are premultiplied (each channel already scaled by
# alpha). The kernel shader is `out = src + dst*(1 - src_a)`, so straight-alpha pixels
# render as an over-bright ghost, silently. sadish's sd_premul() is the sanctioned producer.
fn setu_client_request_premultiplied(c): i64 {
    store64(c + SETU_C_FLAGS, load64(c + SETU_C_FLAGS) | SETU_SURF_PREMULTIPLIED);
    return 0;
}

# The first present's handshake: send CREATE_SURFACE and wait for SURFACE_CREATED. Stores and
# returns the surface id, or returns -41 (send failed), -6 (no reply) or -8 (a reply of another kind).
fn setu__client_create_surface(c, fd, w, h): i64 {
    if (setu_send(fd, setu_create_surface(w, h, load64(c + SETU_C_FLAGS))) < 0) { return 0 - 41; }
    var reply = setu_msg_new();
    if (setu_read_msg(fd, reply) < 0) { return 0 - 6; }
    if (setu_msg_kind(reply) != SETU_SURFACE_CREATED) { return 0 - 8; }
    var id = setu_msg_arg(reply, 0);
    store64(c + SETU_C_SID, id);
    return id;
}

# Present an already-rendered w*h BGRA pixel buffer `pix`: copy it into the client's shared
# buffer (buf.cyr — made on the first present, rewritten in place after that since the
# compositor re-reads the id it holds, replaced on a resize, freed by setu_client_close), then
# send ATTACH naming that buffer by id, then COMMIT. The first present also creates the surface
# (CREATE_SURFACE -> SURFACE_CREATED), once the buffer is ready.
# Returns 0 or a negative code: -45 no shared buffer could be made, -46 writing it failed (for
# both NOTHING was sent, so presenting again is a clean retry, and a resize keeps the old buffer),
# -41 create send, -6 recv, -8 unexpected reply, -42 attach send, -44 commit send.
# -43 was the retired inline pixel write.
fn setu_client_present(c, pix, w, h): i64 {
    var fd = setu_client_fd(c);
    var stride = w * 4;
    var nbytes = h * stride;
    # ⛔ THE BUFFER FIRST, AND NO INLINE FALLBACK. An ATTACH with buf_id = 0 promises pixels on the
    # connection, and they cannot follow: a send is one record of at most 64 B on both targets, so
    # setu_write_all refuses them, and aethersafha refuses that form on both of its handlers anyway.
    # The fallback that tried it left the compositor holding an ATTACH whose pixels never came. The
    # buffer is therefore made and filled before anything is sent, including the first present's
    # CREATE_SURFACE, so a present that fails here leaves the wire exactly as it found it.
    # ⚠ Reachable: agnos has 16 shm slots system-wide and a #71 slot holds at most 2 MB (QEMU has no
    # other kind); a /dev/shm write can fail on Linux.
    #
    # ⛔ A RESIZE MAKES THE NEW BUFFER BEFORE IT FREES THE OLD ONE. The compositor re-reads the id it
    # was last attached, every frame. Freeing that buffer first meant a failed create (any grow past
    # 2 MB under QEMU) left the client nothing to present from and the compositor reading a freed
    # slot id, which agnos gives to the next client that asks. So a replacement is only a local until
    # an ATTACH naming it is out. If anything fails before that it is freed, and the held buffer stays
    # as it was, still showing the last good frame.
    # ⚠ The cost is a second slot for the length of one present. With all 16 in use, a resize now
    # fails (-45) where freeing first would have made room, and the window keeps its old size until a
    # slot frees.
    var held = load64(c + SETU_C_BUFID);
    var buf_id = held;
    if (held > 0) {
        if (load64(c + SETU_C_BUFSZ) != nbytes) { buf_id = 0; }    # resize: needs a replacement
    }
    if (buf_id <= 0) {
        buf_id = setu_buf_create(nbytes);
        if (buf_id <= 0) { return 0 - 45; }
        if (held <= 0) {                                           # nothing to replace: cache it now
            held = buf_id;
            store64(c + SETU_C_BUFID, buf_id);
            store64(c + SETU_C_BUFSZ, nbytes);
        }
    }
    if (setu_buf_write(buf_id, pix, nbytes) != 0) {
        setu_buf_close(buf_id);
        if (buf_id == held) {
            # The held buffer is dead: drop it rather than retry it every frame; the next present
            # makes a fresh one. A failed replacement leaves the held buffer as it was.
            store64(c + SETU_C_BUFID, 0);
            store64(c + SETU_C_BUFSZ, 0);
        }
        return 0 - 46;
    }
    var rc = 0;
    var id = setu_client_sid(c);
    if (id == 0) {
        id = setu__client_create_surface(c, fd, w, h);
        if (id < 0) { rc = id; }
    }
    if (rc == 0) {
        if (setu_send(fd, setu_attach_buf(id, w, h, stride, 1, buf_id)) < 0) { rc = 0 - 42; }
    }
    if (rc < 0) {
        if (buf_id != held) { setu_buf_close(buf_id); }            # never attached: the held one stands
        return rc;
    }
    if (buf_id != held) {                                          # the compositor now reads `buf_id`
        setu_buf_close(held);
        store64(c + SETU_C_BUFID, buf_id);
        store64(c + SETU_C_BUFSZ, nbytes);
    }
    if (setu_send(fd, setu_commit(id)) < 0) { return 0 - 44; }
    return 0;
}

# Read the next setu frame off the client's connection into `msg_out` (one
# record, blocking). Returns the frame length (> 0), or -6 on EOF/error. The consumer
# interprets the message (INPUT_KEY / CONFIGURE / CLOSE ...).
fn setu_client_recv(c, msg_out): i64 {
    return setu_read_msg(setu_client_fd(c), msg_out);
}

# Extract ONE complete frame from the client's reassembly buffer into `msg_out`
# (no syscall). Returns 1 when a frame was decoded, 0 when the buffered bytes
# don't yet hold a complete frame. A desynced header (bad argc) resets the buffer
# — the stream has no resync marker, so dropping is the only safe recovery.
fn setu__inbuf_take(c, msg_out): i64 {
    var ib = load64(c + SETU_C_INBUF);
    var len = load64(c + SETU_C_INLEN);
    if (ib == 0) { return 0; }
    if (len < 16) { return 0; }
    var argc = setu_get_i64(ib, 8);
    if (argc < 0) { store64(c + SETU_C_INLEN, 0); return 0; }
    if (argc > SETU_MAX_ARGS) { store64(c + SETU_C_INLEN, 0); return 0; }
    var total = (2 + argc) * 8;
    if (len < total) { return 0; }
    var dec = setu_decode(ib, total, msg_out);
    var rem = len - total;                       # shift the remainder down
    var i = 0;
    while (i < rem) { store8(ib + i, load8(ib + total + i)); i = i + 1; }
    store64(c + SETU_C_INLEN, rem);
    if (dec < 0) { return 0; }                   # garbled frame consumed; caller re-polls
    return 1;
}

# NON-BLOCKING poll for the next inbound frame with STREAM REASSEMBLY: buffers leftover
# bytes in the client and hands out one frame per call. Use this, not setu_poll_input —
# a dropped coalesced tail loses key-RELEASE events, which sticks keys for FULL_KEYS
# consumers. Returns 1 and fills `msg_out` when a frame is ready, 0 when nothing is
# pending, or -6 on EOF/error with nothing buffered. Call in a loop until 0 to drain.
fn setu_client_poll_input(c, msg_out): i64 {
    var ib = load64(c + SETU_C_INBUF);
    if (ib == 0) {
        ib = alloc(SETU_C_INBUF_CAP);
        store64(c + SETU_C_INBUF, ib);
        store64(c + SETU_C_INLEN, 0);
    }
    # A complete frame may already be buffered from the last read — no syscall.
    if (setu__inbuf_take(c, msg_out) == 1) { return 1; }
    var len = load64(c + SETU_C_INLEN);
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ SAME MISS AS setu_poll_input — see there. A channel fd never routes through `sys_read`.
    # ⚠ The reassembly buffer below stays: a record is all-or-nothing per SEND, but a CLIENT may still
    # need more than one record to make a frame, and the take/partial logic is transport-agnostic.
    var r = sys_chan_recv(load64(c + SETU_C_FD), ib + len, SETU_C_INBUF_CAP - len);
    if (r == 0 - CH_E_WOULDBLOCK) { r = 0; }       # map to the "idle" convention this function uses
    if (r == 0 - CH_E_PEERGONE) { r = 0 - 1; }
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # See setu_poll_input: MSG_DONTWAIT keeps the fd blocking for read_blk while this poll returns
    # immediately. EAGAIN maps to the "idle" convention (0) this function already uses.
    var r = sys_recvfrom(load64(c + SETU_C_FD), ib + len, SETU_C_INBUF_CAP - len, SETU_MSG_DONTWAIT, 0, 0);
    if (r < 0) { r = 0; }
    #endif
    if (r > 0) {
        store64(c + SETU_C_INLEN, len + r);
        if (setu__inbuf_take(c, msg_out) == 1) { return 1; }
        return 0;                                # partial frame — completes next poll
    }
    if (r == 0) { return 0; }                    # nothing pending (agnos WOULDBLOCK, Linux EAGAIN)
    # ⚠ Linux EOF and recv errors land here too (EOF-as-idle), where setu_poll_input returns -6 for EOF.
    if (len > 0) { return 0; }                   # error but bytes pending — drain first
    return 0 - 6;                                # EOF / error
}

fn setu_client_close(c): i64 {
    var buf_id = load64(c + SETU_C_BUFID);
    if (buf_id > 0) {
        setu_buf_close(buf_id);
        store64(c + SETU_C_BUFID, 0);
        store64(c + SETU_C_BUFSZ, 0);
    }
    # ⛔ A CHANNEL ENDPOINT IS RELEASED BY `CH_CLOSE`, NOT BY `sock_close`. `sock_close` lands on
    # `sys_close` → `vfs_close_inner`, which has cases for PIPE and SOCK but **none for VFS_CHAN** — it
    # zeroes the fd slot and leaves `chan_end_open`/`chan_end_owner` set until the process dies. That is
    # an endpoint leak for the whole life of a long-running client.
    #ifdef CYRIUS_TARGET_AGNOS
    sys_chan_close(setu_client_fd(c));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    sys_close(setu_client_fd(c));
    #endif
    return 0;
}
