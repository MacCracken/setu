# client.cyr — setu's reference CLIENT + SERVER transport (persistent connection),
# shared by every consumer (dhancha, puka, crab) so there is ONE client, not three.
# setu = the protocol CONTRACT (proto/codec) + this transport.
#
# Transport: TCP over loopback : SETU_TCP_PORT via cyrius `net.cyr` — Linux BSD
# sockets on the host, the agnos kernel TCP band on agnos (connect #47, send/recv
# #48/#49, listen/accept #56/#57). `path` params are advisory (API compat only).
#
# Two agnos socket semantics the framing absorbs (both #ifdef-guarded, so Linux
# behaviour is unchanged):
#   - `sock_recv` #49 is NON-BLOCKING: 0 = would-block, -1 = EOF (inverted from Linux).
#   - `sock_send` #48 may send < len, so writes loop.
#
# Model: connect once → create surface once → ATTACH + pixels + COMMIT per present.

var SETU_TCP_PORT = 7700;   # the compositor's well-known setu loopback port

# =========================================================================
# TCP transport + framing primitives (over the setu codec, via net.cyr)
# =========================================================================

# Connect to the compositor's setu endpoint (loopback : SETU_TCP_PORT). Returns the
# connected fd (>= 0), or -2 (socket) / -3 (connect). `setu_connect_error` /
# `setu_connect_rc` separate the two failures, which otherwise collapse to one message.
var setu_conn_err = 0;      # -2 socket, -3 connect. 0 = last one worked.
var setu_conn_rc = 0;       # raw sys_sock_connect return behind a -3.
fn setu_connect_error(): i64 { return setu_conn_err; }
fn setu_connect_rc(): i64 { return setu_conn_rc; }

fn setu_connect(path): i64 {
    setu_conn_err = 0;
    setu_conn_rc = 0;
    var s = tcp_socket();
    if (is_ok(s) == 0) { setu_conn_err = 0 - 2; return 0 - 2; }
    var fd = result_unwrap(s);
    #ifdef CYRIUS_TARGET_AGNOS
    # ⚠ Requires agnos >= 1.56.35 (`net_src_for`): older kernels stamped net_ip as the
    # source of every outbound segment, so a loopback SYN's reply never matched the 4-tuple.
    var conn = sys_sock_connect(0x7F000001, SETU_TCP_PORT, 0);
    setu_conn_rc = conn;
    if (conn < 0) {
        sock_close(fd);
        setu_conn_err = 0 - 3;
        return 0 - 3;
    }
    _agnos_sock_bind(fd, conn);
    return fd;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (is_ok(sock_connect(fd, INADDR_LOOPBACK(), SETU_TCP_PORT)) == 0) {
        sock_close(fd);
        setu_conn_err = 0 - 3;
        return 0 - 3;
    }
    return fd;
    #endif
}

# --- server transport (the compositor owns the listener) ---------------------

# Bind + listen on the setu endpoint (loopback : SETU_TCP_PORT). `path` advisory.
# Returns the listening fd (>= 0), or -2 (socket) / -3 (bind) / -4 (listen). The
# fd is set non-blocking so setu_accept polls (agnos #57 is already non-blocking).
fn setu_listen(path): i64 {
    var s = tcp_socket();
    if (is_ok(s) == 0) { return 0 - 2; }
    var fd = result_unwrap(s);
    #ifndef CYRIUS_TARGET_AGNOS
    sock_reuse(fd);                                  # SO_REUSEADDR — rebind after a restart
    #endif
    if (is_ok(sock_bind(fd, INADDR_LOOPBACK(), SETU_TCP_PORT)) == 0) { sock_close(fd); return 0 - 3; }
    if (is_ok(sock_listen(fd, 8)) == 0) { sock_close(fd); return 0 - 4; }
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(fd);                        # accept polls (agnos accept is already non-blocking)
    #endif
    return fd;
}

# Accept the next pending client on `sfd`. Returns the client fd (>= 0), or -5
# when none is pending (WOULD_BLOCK — the compositor polls again next frame).
# Non-blocking on BOTH targets, so the frame loop never stalls on accept.
fn setu_accept(sfd): i64 {
    var a = sock_accept(sfd);
    if (is_ok(a) == 1) { return result_unwrap(a); }
    return 0 - 5;                                    # EAGAIN / no client pending
}

# --- write --------------------------------------------------------------------

# Write EXACTLY `n` bytes from `buf` to `fd`, looping over partial sends (agnos
# sock_send #48 may send < len). Returns `n` (>= 0) or -7 on a write error.
fn setu_write_all(fd, buf, n): i64 {
    var sent = 0;
    while (sent < n) {
        var w = sys_write(fd, buf + sent, n - sent);
        if (w <= 0) { return 0 - 7; }
        sent = sent + w;
    }
    return n;
}

# Encode `msg` and write the whole frame to `fd`. Returns bytes written (> 0), a
# negated SetuErr on encode failure, or -7 on a write error. Widest frame ≤ 128 B.
fn setu_send(fd, msg): i64 {
    var cap = 128;
    var buf = alloc(cap);
    var enc = setu_encode(msg, buf, cap);
    if (enc < 0) { return enc; }
    if (setu_write_all(fd, buf, enc) < 0) { return 0 - 7; }
    return enc;
}

# Read at least 1 byte into `buf` (cap `cap`), blocking until data / EOF. Absorbs
# agnos's non-blocking recv (0 = would-block → yield + bounded retry) vs Linux's
# blocking read (0 = EOF). Returns bytes (> 0), or -6 on EOF / error / timeout.
fn setu_read_blk(fd, buf, cap): i64 {
    var tries = 0;
    while (tries <= 5000) {
        var r = sys_read(fd, buf, cap);
        #ifdef CYRIUS_TARGET_AGNOS
        if (r < 0) { return 0 - 6; }               # -1 = EOF / error
        if (r > 0) { return r; }                   # got bytes
        tries = tries + 1;                          # r == 0 → would-block
        sys_sleep_ms(2);                            # yield (~10s cap at 5000*2ms)
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        if (r <= 0) { return 0 - 6; }               # 0 = EOF on Linux
        return r;
        #endif
    }
    return 0 - 6;                                    # would-block timeout (agnos)
}

# Read ONE setu frame from `fd` into `msg_out` via a single bulk read. Returns
# the decoded length (> 0), -6 on EOF, or a negated SetuErr. Use setu_read_msg
# (length-framed) when reading a continuous STREAM of frames.
fn setu_recv(fd, msg_out): i64 {
    var cap = 256;
    var buf = alloc(cap);
    var n = setu_read_blk(fd, buf, cap);
    if (n <= 0) { return 0 - 6; }
    return setu_decode(buf, n, msg_out);
}

# NON-BLOCKING poll for ONE inbound frame (the S->C input channel). Returns 1 and fills
# `msg_out` when a frame arrived, 0 when nothing is pending, or -6 on EOF/error — the
# caller's animation loop never stalls.
# ⚠ Decodes only the FIRST frame of each recv; coalesced or split frames are dropped.
# Kept for API compat — stream consumers use setu_client_poll_input, which reassembles.
fn setu_poll_input(fd, msg_out): i64 {
    var cap = 256;
    var buf = alloc(cap);
    var r = sys_read(fd, buf, cap);        # agnos: non-blocking (0 = would-block, -1 = EOF)
    if (r == 0) { return 0; }              # nothing buffered → no input this frame
    if (r < 0)  { return 0 - 6; }          # EOF / error
    if (setu_decode(buf, r, msg_out) < 0) { return 0; }   # partial/garbled → skip
    return 1;
}

# Read EXACTLY `n` bytes from `fd` into `buf`, looping over short/would-block
# reads. Returns `n` (>= 0) or -6 on EOF/error.
fn setu_read_exact(fd, buf, n): i64 {
    var got = 0;
    while (got < n) {
        var r = setu_read_blk(fd, buf + got, n - got);
        if (r <= 0) { return 0 - 6; }
        got = got + r;
    }
    return got;
}

# Read ONE full setu frame from `fd` into `msg_out` using length-from-header
# framing (kind + argc header -> (2+argc)*8 total bytes). Returns the frame
# length (> 0), -6 on EOF / short read / bad argc, or a negated SetuErr. Use this
# (not setu_recv) when reading a continuous stream of frames — the input path.
fn setu_read_msg(fd, msg_out): i64 {
    var buf = alloc(128);
    if (setu_read_exact(fd, buf, 16) < 0) { return 0 - 6; }
    var argc = setu_get_i64(buf, 8);
    if (argc < 0) { return 0 - 6; }
    if (argc > SETU_MAX_ARGS) { return 0 - 6; }
    var total = (2 + argc) * 8;
    if (total > 16) {
        if (setu_read_exact(fd, buf + 16, total - 16) < 0) { return 0 - 6; }
    }
    return setu_decode(buf, total, msg_out);
}

# =========================================================================
# SetuClient — the persistent app-facing handle ("each app owns its connection")
# =========================================================================

enum SetuClientOff {
    SETU_C_FD    = 0;    # connected setu fd
    SETU_C_SID   = 8;    # compositor-assigned surface id (0 until first present)
    SETU_C_FLAGS = 16;   # CREATE_SURFACE flags to request (e.g. SETU_SURF_FULL_KEYS)
    SETU_C_BUFID = 24;   # cached shared-buffer id (0 = none) — ONE per client, reused
    # across presents, recreated on resize, freed at close.
    # ⛔ Never create one per present: that exhausts agnos's 16
    # kernel shm slots in under a second at 35 Hz.
    SETU_C_BUFSZ = 32;   # size in bytes of the cached shared buffer
    SETU_C_INBUF = 40;   # input stream-reassembly buffer (lazily alloc'd, 0 until first poll)
    SETU_C_INLEN = 48;   # bytes currently buffered in SETU_C_INBUF
    SETU_C_SZ    = 56;
}

var SETU_C_INBUF_CAP = 512;   # ≥ 6 widest frames ((2+8)*8 = 80 B); input frames are 40 B

# Connect to the compositor's setu endpoint. Returns a *SetuClient, or 0 on
# failure. The surface is created lazily on the first setu_client_present.
# ⛔ No retry loop here: agnos `sock_connect` #47 holds preempt for the whole attempt,
# so a retrying client starves the compositor it is waiting for.
fn setu_client_connect(path): i64 {
    var fd = setu_connect(path);
    if (fd < 0) { return 0; }
    var c = alloc(SETU_C_SZ);
    store64(c + SETU_C_FD, fd);
    store64(c + SETU_C_SID, 0);
    store64(c + SETU_C_FLAGS, 0);
    store64(c + SETU_C_BUFID, 0);
    store64(c + SETU_C_BUFSZ, 0);
    store64(c + SETU_C_INBUF, 0);
    store64(c + SETU_C_INLEN, 0);
    return c;
}

fn setu_client_fd(c): i64  { return load64(c + SETU_C_FD); }
fn setu_client_sid(c): i64 { return load64(c + SETU_C_SID); }

# Request FULL keyboard events (press AND release) for this client's surface so an app
# can track HELD keys, instead of the default press-only stream. Call BEFORE the first
# setu_client_present — the flag rides the CREATE_SURFACE handshake (arg2). The compositor
# then delivers SETU_INPUT_KEY with arg2 = 1 (press) / 0 (release). Press-only clients
# (that never call this) keep flags 0, so the compositor sends presses only with arg2 = 0
# — byte-identical to the pre-0.5.0 behaviour. Returns 0.
fn setu_client_request_keys(c): i64 {
    store64(c + SETU_C_FLAGS, load64(c + SETU_C_FLAGS) | SETU_SURF_FULL_KEYS);
    return 0;
}

# @public — declare that this client's surface pixels are PREMULTIPLIED BGRA (c <= a), so the
# compositor blends per-pixel (gpu_shader_op#92 op 0x01) instead of copying opaquely
# (gpu_blit_shm#87). Call BEFORE setu_client_connect — the flag rides CREATE_SURFACE.
# ⚠ Only set this if the pixels really are premultiplied (each channel already scaled by
# alpha). The kernel shader is `out = src + dst*(1 - src_a)`, so straight-alpha pixels
# render as an over-bright ghost, silently. sadish's sd_premul() is the sanctioned producer.
fn setu_client_request_premultiplied(c): i64 {
    store64(c + SETU_C_FLAGS, load64(c + SETU_C_FLAGS) | SETU_SURF_PREMULTIPLIED);
    return 0;
}

# Present an already-rendered w*h BGRA pixel buffer `pix`. The first present creates
# the surface (CREATE_SURFACE -> SURFACE_CREATED) and the shared buffer; each present
# hands pixels over by buffer id (ATTACH-by-id), falling back to inline pixels when the
# shared-buffer backend is unavailable. Returns 0 or a negative code (-41 create send,
# -6 recv, -8 unexpected reply, -42 attach send, -43 pixel write, -44 commit send,
# -45 buffer map).
fn setu_client_present(c, pix, w, h): i64 {
    var fd = setu_client_fd(c);
    var id = setu_client_sid(c);
    if (id == 0) {
        if (setu_send(fd, setu_create_surface(w, h, load64(c + SETU_C_FLAGS))) < 0) { return 0 - 41; }
        var reply = setu_msg_new();
        if (setu_read_msg(fd, reply) < 0) { return 0 - 6; }
        if (setu_msg_kind(reply) != SETU_SURFACE_CREATED) { return 0 - 8; }
        id = setu_msg_arg(reply, 0);
        store64(c + SETU_C_SID, id);
    }
    var stride = w * 4;
    var nbytes = h * stride;
    # --- Shared-buffer present. Created once and rewritten in place every present (the
    #     compositor re-reads the id it holds on each commit); a resize recreates it.
    #     Freed in setu_client_close. ---
    var buf_id = load64(c + SETU_C_BUFID);
    if (buf_id > 0) {
        if (load64(c + SETU_C_BUFSZ) != nbytes) {          # resize -> recreate
            setu_buf_close(buf_id);
            buf_id = 0;
            store64(c + SETU_C_BUFID, 0);
            store64(c + SETU_C_BUFSZ, 0);
        }
    }
    if (buf_id <= 0) {
        buf_id = setu_buf_create(nbytes);
        if (buf_id > 0) {
            store64(c + SETU_C_BUFID, buf_id);
            store64(c + SETU_C_BUFSZ, nbytes);
        }
    }
    if (buf_id > 0) {
        if (setu_buf_write(buf_id, pix, nbytes) == 0) {
            if (setu_send(fd, setu_attach_buf(id, w, h, stride, 1, buf_id)) < 0) { return 0 - 42; }
            if (setu_send(fd, setu_commit(id)) < 0) { return 0 - 44; }
            return 0;
        }
        # Write failed — drop the cached buffer (don't retry a dead id every frame)
        # and fall through to the inline path for this present.
        setu_buf_close(buf_id);
        store64(c + SETU_C_BUFID, 0);
        store64(c + SETU_C_BUFSZ, 0);
    }
    # --- Inline fallback: shared-buffer backend unavailable. ATTACH's arg5 (buf_id)
    #     stays 0 → the server reads inline pixels. ---
    if (setu_send(fd, setu_attach(id, w, h, stride, 1)) < 0) { return 0 - 42; }
    if (setu_write_all(fd, pix, nbytes) < 0) { return 0 - 43; }
    if (setu_send(fd, setu_commit(id)) < 0) { return 0 - 44; }
    return 0;
}

# Read the next setu frame off the client's connection into `msg_out` (stream
# framing). Returns the frame length (> 0), or -6 on EOF/error. The consumer
# interprets the message (INPUT_KEY / CONFIGURE / CLOSE ...).
fn setu_client_recv(c, msg_out): i64 {
    return setu_read_msg(setu_client_fd(c), msg_out);
}

# Extract ONE complete frame from the client's reassembly buffer into `msg_out`
# (no syscall). Returns 1 when a frame was decoded, 0 when the buffered bytes
# don't yet hold a complete frame. A desynced header (bad argc) resets the buffer
# — the stream has no resync marker, so dropping is the only safe recovery.
fn setu__inbuf_take(c, msg_out): i64 {
    var ib = load64(c + SETU_C_INBUF);
    var len = load64(c + SETU_C_INLEN);
    if (ib == 0) { return 0; }
    if (len < 16) { return 0; }
    var argc = setu_get_i64(ib, 8);
    if (argc < 0) { store64(c + SETU_C_INLEN, 0); return 0; }
    if (argc > SETU_MAX_ARGS) { store64(c + SETU_C_INLEN, 0); return 0; }
    var total = (2 + argc) * 8;
    if (len < total) { return 0; }
    var dec = setu_decode(ib, total, msg_out);
    var rem = len - total;                       # shift the remainder down
    var i = 0;
    while (i < rem) { store8(ib + i, load8(ib + total + i)); i = i + 1; }
    store64(c + SETU_C_INLEN, rem);
    if (dec < 0) { return 0; }                   # garbled frame consumed; caller re-polls
    return 1;
}

# NON-BLOCKING poll for the next inbound frame with STREAM REASSEMBLY: buffers leftover
# bytes in the client and hands out one frame per call. Use this, not setu_poll_input —
# a dropped coalesced tail loses key-RELEASE events, which sticks keys for FULL_KEYS
# consumers. Returns 1 and fills `msg_out` when a frame is ready, 0 when nothing is
# pending, or -6 on EOF/error with nothing buffered. Call in a loop until 0 to drain.
fn setu_client_poll_input(c, msg_out): i64 {
    var ib = load64(c + SETU_C_INBUF);
    if (ib == 0) {
        ib = alloc(SETU_C_INBUF_CAP);
        store64(c + SETU_C_INBUF, ib);
        store64(c + SETU_C_INLEN, 0);
    }
    # A complete frame may already be buffered from the last read — no syscall.
    if (setu__inbuf_take(c, msg_out) == 1) { return 1; }
    var len = load64(c + SETU_C_INLEN);
    var r = sys_read(load64(c + SETU_C_FD), ib + len, SETU_C_INBUF_CAP - len);
    if (r > 0) {
        store64(c + SETU_C_INLEN, len + r);
        if (setu__inbuf_take(c, msg_out) == 1) { return 1; }
        return 0;                                # partial frame — completes next poll
    }
    if (r == 0) { return 0; }                    # agnos: would-block; Linux: EOF-as-idle
    # (matches setu_poll_input's semantics)
    if (len > 0) { return 0; }                   # error but bytes pending — drain first
    return 0 - 6;                                # EOF / error
}

fn setu_client_close(c): i64 {
    var buf_id = load64(c + SETU_C_BUFID);
    if (buf_id > 0) {
        setu_buf_close(buf_id);
        store64(c + SETU_C_BUFID, 0);
        store64(c + SETU_C_BUFSZ, 0);
    }
    sock_close(setu_client_fd(c));
    return 0;
}
