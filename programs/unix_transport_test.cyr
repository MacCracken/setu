# programs/unix_transport_test.cyr — a REAL AF_UNIX/SOCK_SEQPACKET round-trip on Linux.
#
# ⛔ WHY THIS EXISTS. `reach_test.cyr` proves the transport surface LINKS; it never opens a socket.
# `client_test.cyr` proves the CODEC round-trips in memory; it never touches the wire. Neither would
# notice if `setu_listen` bound the wrong family, if `setu_accept` never returned a client, or — the
# one that matters — if the transport silently behaved like a STREAM instead of a record channel.
#
# ⭐ THE LOAD-BEARING ASSERTION IS RECORD FRAMING (below). Everything else here would also pass on
# SOCK_STREAM. Two sends of different sizes must come back as TWO reads of exactly those sizes, with
# no coalescing and no splitting. That is the property the whole setu framing design rests on, and it
# is the property that, when it was absent on the agnos arm, cost three consecutive releases.
#
# It also checks what `setu_client_present` puts on the wire when no shared buffer is available
# (`present_all_or_nothing`): nothing. Only a wire test can see a message that should not be there.
#
# Single process: AF_UNIX `connect()` completes against a listening socket without the peer having
# called `accept()` yet (the connection sits in the backlog), so no fork is needed to have both ends.

include "src/lib.cyr"

var fails = 0;

fn ck(what, got, want) {
    if (got != want) {
        sys_write(1, "unix_transport_test: FAIL ", 26);
        sys_write(1, what, strlen(what));
        sys_write(1, " got=", 5); print_num(got);
        sys_write(1, " want=", 6); print_num(want);
        sys_write(1, "\n", 1);
        fails = fails + 1;
    }
    return 0;
}

#ifndef CYRIUS_TARGET_AGNOS
# The next record waiting on `fd`, decoded into `m`: its length, or -1 when nothing is waiting.
# `kind` is cleared first, so a record that is not a setu frame reads back as kind 0.
fn next_rec(fd, m) {
    var buf = alloc(256);
    setu_msg_set_kind(m, 0);
    var r = sys_recvfrom(fd, buf, 256, SETU_MSG_DONTWAIT, 0, 0);
    if (r < 0) { return 0 - 1; }
    setu_decode(buf, r, m);
    return r;
}

# ⭐ A PRESENT WITH NO SHARED BUFFER SENDS NOTHING. The inline fallback this replaces sent
# ATTACH(buf_id = 0) and then had its pixel write refused by the one-record rule, so the peer held an
# ATTACH whose pixels never came. Now the buffer is made and filled before anything is sent, so a
# failed present leaves the wire as it found it, including the CREATE_SURFACE of a first present.
fn present_all_or_nothing(sfd, path) {
    var c = setu_client_connect(path);
    ck("present: client connect", c != 0, 1);
    if (c == 0) { return 0; }
    var pfd = setu_accept(sfd);
    ck("present: accept", pfd >= 0, 1);
    if (pfd < 0) { return 0; }

    var w = 32;
    var h = 32;
    var nbytes = w * h * 4;                        # 4 KB, far past one 64-byte record
    var pix = alloc(nbytes);
    var i = 0;
    while (i < nbytes) { store8(pix + i, (i * 7 + 3) & 255); i = i + 1; }
    var m = setu_msg_new();
    var p = alloc(48);

    # The client blocks reading SURFACE_CREATED and this test is one process, so the reply is queued
    # up front. Step 1 must leave it unread; step 2's handshake consumes it.
    ck("present: queue reply", setu_send(pfd, setu_surface_created(77)) > 0, 1);

    # --- 1. No buffer can be created on the FIRST present. A directory at the path setu_buf_create
    # picks next makes its open() fail EISDIR.
    # ⚠ This predicts buf.cyr's naming (pid * 100000 + counter). If that changes the create succeeds,
    # present returns 0, and the rc check fails, so it cannot pass vacuously.
    setu_buf_path(sys_getpid() * 100000 + _setu_buf_counter + 1, p);
    ck("present: occupy next buffer path", sys_mkdirat(AT_FDCWD, p, 448), 0);
    ck("present: create fails, rc", setu_client_present(c, pix, w, h), 0 - 45);
    ck("present: create fails, wire empty", next_rec(pfd, m), 0 - 1);
    ck("present: create fails, no surface", setu_client_sid(c), 0);
    sys_unlinkat(AT_FDCWD, p, AT_REMOVEDIR);

    # --- 2. The next present recovers: CREATE_SURFACE, ATTACH by id, COMMIT.
    ck("present: recovers, rc", setu_client_present(c, pix, w, h), 0);
    next_rec(pfd, m);
    ck("present: rec 1 kind", setu_msg_kind(m), SETU_CREATE_SURFACE);
    next_rec(pfd, m);
    ck("present: rec 2 kind", setu_msg_kind(m), SETU_ATTACH);
    ck("present: rec 2 sid", setu_msg_arg(m, 0), 77);
    var bid = setu_msg_arg(m, 5);
    ck("present: rec 2 names a buffer", bid > 0, 1);
    next_rec(pfd, m);
    ck("present: rec 3 kind", setu_msg_kind(m), SETU_COMMIT);
    ck("present: nothing after commit", next_rec(pfd, m), 0 - 1);
    var back = alloc(nbytes);
    ck("present: buffer read by id", setu_buf_read(bid, back, nbytes), 0);
    var miss = 0;
    i = 0;
    while (i < nbytes) {
        if (load8(back + i) != load8(pix + i)) { miss = miss + 1; }
        i = i + 1;
    }
    ck("present: buffer holds the frame", miss, 0);

    # --- 3. The cached buffer stops taking writes: fail before ATTACH and drop the dead id.
    setu_buf_path(bid, p);
    sys_unlinkat(AT_FDCWD, p, 0);
    ck("present: occupy cached buffer path", sys_mkdirat(AT_FDCWD, p, 448), 0);
    ck("present: write fails, rc", setu_client_present(c, pix, w, h), 0 - 46);
    ck("present: write fails, wire empty", next_rec(pfd, m), 0 - 1);
    ck("present: write fails, id dropped", load64(c + SETU_C_BUFID), 0);
    sys_unlinkat(AT_FDCWD, p, AT_REMOVEDIR);

    # --- 4. The next present makes a fresh buffer, and the surface is not created twice.
    ck("present: after write failure, rc", setu_client_present(c, pix, w, h), 0);
    next_rec(pfd, m);
    ck("present: rec 4 kind", setu_msg_kind(m), SETU_ATTACH);
    ck("present: rec 4 fresh buffer", setu_msg_arg(m, 5) != bid, 1);
    ck("present: rec 4 buffer id", setu_msg_arg(m, 5) > 0, 1);
    next_rec(pfd, m);
    ck("present: rec 5 kind", setu_msg_kind(m), SETU_COMMIT);
    ck("present: nothing after rec 5", next_rec(pfd, m), 0 - 1);

    setu_client_close(c);                          # frees the cached buffer
    sys_close(pfd);
    return 0;
}
#endif

fn main(): i64 {
    alloc_init();
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no AF_UNIX and needs none — clients are PLACED on an endowed channel end. Nothing to
    # exercise here; the agnos transport is covered by the kernel's own ring-3 exerciser (chanx).
    sys_write(1, "unix_transport_test: SKIP (agnos has no AF_UNIX; clients are placed)\n", 68);
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var path = "/tmp/setu-unix-transport-test.sock";

    var sfd = setu_listen(path);
    if (sfd < 0) { sys_write(1, "unix_transport_test: FAIL listen\n", 33); return 1; }

    var cfd = setu_connect(path);
    if (cfd < 0) { sys_write(1, "unix_transport_test: FAIL connect\n", 34); return 1; }

    var afd = setu_accept(sfd);
    if (afd < 0) { sys_write(1, "unix_transport_test: FAIL accept\n", 33); return 1; }

    # --- a real framed message, client -> server ---
    var sent = setu_send(cfd, setu_create_surface(320, 200, 0));
    ck("send rc", sent > 0, 1);
    var got = setu_msg_new();
    var rl = setu_read_msg(afd, got);
    ck("read_msg rc", rl > 0, 1);
    ck("kind", setu_msg_kind(got), SETU_CREATE_SURFACE);
    ck("arg0 w", setu_msg_arg(got, 0), 320);
    ck("arg1 h", setu_msg_arg(got, 1), 200);

    # --- and server -> client, so both directions are proven ---
    ck("reply rc", setu_send(afd, setu_surface_created(77)) > 0, 1);
    var back = setu_msg_new();
    ck("reply read", setu_read_msg(cfd, back) > 0, 1);
    ck("reply kind", setu_msg_kind(back), SETU_SURFACE_CREATED);
    ck("reply sid", setu_msg_arg(back, 0), 77);

    # ⭐⭐ THE RECORD-BOUNDARY ASSERTION — the reason this file exists.
    # Two writes of DIFFERENT sizes, then two reads. On SOCK_SEQPACKET each read returns exactly one
    # record. On SOCK_STREAM the first read would return all 40 bytes coalesced and the second would
    # block — which is precisely the stream-vs-record confusion that broke the agnos arm.
    var a = alloc(64);
    var b = alloc(64);
    var i = 0;
    while (i < 24) { store8(a + i, 65 + (i % 26)); i = i + 1; }   # 24-byte record
    i = 0;
    while (i < 16) { store8(b + i, 97 + (i % 26)); i = i + 1; }   # 16-byte record
    ck("rec1 write", sys_write(cfd, a, 24), 24);
    ck("rec2 write", sys_write(cfd, b, 16), 16);
    var r1 = alloc(128);
    var r2 = alloc(128);
    ck("rec1 read len", setu_read_blk(afd, r1, 128), 24);   # NOT 40 — no coalescing
    ck("rec2 read len", setu_read_blk(afd, r2, 128), 16);
    ck("rec1 byte0", load8(r1), 65);
    ck("rec2 byte0", load8(r2), 97);

    present_all_or_nothing(sfd, path);

    sys_close(afd);
    sys_close(cfd);
    sys_close(sfd);

    if (fails != 0) { sys_write(1, "unix_transport_test: FAILED\n", 28); return 1; }
    var ok = "unix_transport_test: PASS (AF_UNIX SOCK_SEQPACKET: connect/accept,\n";
    sys_write(1, ok, strlen(ok));
    var ok2 = "  both directions, RECORD boundaries preserved, and a present\n";
    sys_write(1, ok2, strlen(ok2));
    var ok3 = "  with no shared buffer sends nothing)\n";
    sys_write(1, ok3, strlen(ok3));
    return 0;
    #endif
}

fn _entry(): i64 { args_init(); var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
