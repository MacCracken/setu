[package]
name = "setu"
version = "${file:VERSION}"
description = "setu (सेतु — bridge) — the AGNOS native display protocol: message types, a pure wire codec, the shared-buffer present path and the reference transport between GUI clients and the aethersafha compositor. Agent-free by construction."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/setu"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "programs/smoke.cyr"
output = "build/setu-smoke"

[lib]
modules = [
    "src/error.cyr",
    "src/proto.cyr",
    "src/codec.cyr",
    "src/buf.cyr",
    "src/client.cyr",
]

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "result", "net", "chrono", "args"]
